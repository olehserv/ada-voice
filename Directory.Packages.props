<Project>

  <!--
    Central package management: every package version lives here, once. Project files list the
    package name only (no Version). This stops the same dependency drifting to two versions
    across projects as the solution grows (UI, storage, services are still to come).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Audio core (no Windows dependency) -->
    <PackageVersion Include="NAudio.Core" Version="2.2.1" />
    <!-- WASAPI / COM seam (Windows only) -->
    <PackageVersion Include="NAudio.Wasapi" Version="2.2.1" />

    <!-- Host logging (rolling file, for post-hoc diagnosis of audio issues) -->
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- WPF UI: MVVM helpers (ObservableObject, RelayCommand) -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- WPF-UI: Fluent (Windows 11) theme + controls for the Board (design 09) -->
    <PackageVersion Include="WPF-UI" Version="4.3.0" />

    <!-- Server: EF Core 10 + PostgreSQL (Npgsql). Persistence lives in Infrastructure.
         Microsoft.EntityFrameworkCore is pinned explicitly (and referenced directly by
         Infrastructure) at the same 10.0.9 as EFCore.Design; otherwise Npgsql's own
         [10.0.4, 11.0.0) range resolves it to the older 10.0.4 for Infrastructure while Api
         (via EFCore.Design) resolves 10.0.9, and MSBuild's assembly-reference resolution
         can't reconcile the two DLL versions once Tests references both projects (MSB3277). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- PasswordHasher for the Task-4 seeder; referenced now so Infrastructure is ready. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.9" />
    <!-- Design-time only (dotnet ef); added to the Api with PrivateAssets=all. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <!-- Auth (Phase 2): JWT bearer validation. Added now (Task 1) so Api references it;
         actual token validation wiring lands in Task 2. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />

    <!-- Test stack -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- WebApplicationFactory for in-process Api integration tests (Task 1+). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
