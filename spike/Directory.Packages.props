<Project>

  <!--
    Shadows the repo-root Directory.Packages.props for the throwaway spike (NuGet uses the
    nearest one up the tree). Central package management stays OFF here so the spike can keep
    pinning its own NAudio version inline, independent of the product dependency set.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
