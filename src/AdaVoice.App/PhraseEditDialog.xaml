<ui:FluentWindow
    x:Class="AdaVoice.App.PhraseEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:AdaVoice.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.PhraseEdit_Title}"
    Width="380"
    Background="{DynamicResource Surface.Window}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI Variable, Segoe UI"
    FontSize="{StaticResource FontSize.Body}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    TextElement.Foreground="{DynamicResource Text.Primary}"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="{x:Static res:Strings.PhraseEdit_Title}"
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="{StaticResource Space.DialogContent}">
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Static res:Strings.PhraseEdit_TitleLabel}" />
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Margin="0,12,0,4"
                Style="{StaticResource FieldLabelStyle}"
                Text="{x:Static res:Strings.PhraseEdit_CategoryLabel}" />
            <ComboBox
                ItemsSource="{Binding Categories}"
                SelectedValue="{Binding SelectedCategoryId}"
                SelectedValuePath="Id">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                CornerRadius="{StaticResource Radius.Small}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Converter={StaticResource CategoryName}}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock
                Margin="0,12,0,4"
                Style="{StaticResource FieldLabelStyle}"
                Text="{x:Static res:Strings.PhraseEdit_TagsLabel}" />

            <!--  Current tags as removable chips  -->
            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,6,6"
                            Padding="8,3"
                            Background="{DynamicResource Surface.Overlay}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Pill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                <Button
                                    MinWidth="24"
                                    MinHeight="24"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Static res:Strings.PhraseEdit_RemoveTag}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="✕"
                                    Cursor="Hand"
                                    Foreground="{DynamicResource Text.Secondary}"
                                    ToolTip="{x:Static res:Strings.PhraseEdit_RemoveTag}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Add a new tag  -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    Grid.Column="0"
                    PlaceholderText="{x:Static res:Strings.PhraseEdit_AddTagPlaceholder}"
                    Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddTagCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <ui:Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Appearance="Secondary"
                    Command="{Binding AddTagCommand}"
                    Content="{x:Static res:Strings.PhraseEdit_Add}" />
            </Grid>

            <!--  Reuse an existing tag  -->
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,0,6,6"
                            Padding="8,3"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Border.Strong}"
                            BorderThickness="1"
                            Command="{Binding DataContext.AddSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="{Binding}"
                            Cursor="Hand"
                            Foreground="{DynamicResource Text.Secondary}"
                            ToolTip="{x:Static res:Strings.PhraseEdit_AddExistingTag}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel
                Margin="{StaticResource Space.ButtonRow}"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Content="{x:Static res:Strings.PhraseEdit_Cancel}"
                    IsCancel="True" />
                <ui:Button
                    x:Name="SaveButton"
                    Click="Save_Click"
                    Content="{x:Static res:Strings.PhraseEdit_Save}"
                    IsDefault="True"
                    IsEnabled="{Binding HasValidTitle}"
                    Style="{StaticResource BrandCtaButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
