<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        Brand styles. Colour tokens are DynamicResource so a runtime light/dark swap re-resolves
        them; sizes/radii are StaticResource (theme-invariant).
    -->

    <!--
        App-wide text-colour consistency fix (found during Phase C, confirmed via pixel-sampling
        rendered PNGs — the same discipline as Phase A's Appearance="Danger"/"Success" finding).
        WPF-UI's own default styles for CheckBox/TextBox/TitleBar each set an explicit Foreground
        Setter (reading a WPF-UI-internal token, ~#323232 in light theme) — a Style Setter is a
        LOCAL value, so it wins over the window's INHERITED TextElement.Foreground="Text.Primary"
        (#221E17) regardless of DynamicResource. Plain TextBlock has no such override and already
        renders correctly. Confirmed app-wide (SettingsWindow, ManageCategoriesDialog,
        ManageConversationsDialog all showed the same #323232/#333333, not #221E17) via
        System.Drawing pixel-sampling of the rendered PNGs, not eyeballing — the difference reads
        as "fine" at a glance since both tones are dark enough to be legible, which is why it went
        unnoticed until now. A derived Style's own Setter always overrides its BasedOn parent's
        Setter for the same property (unlike ListBoxItem's baked-in ControlTemplate selection
        trigger below, which no external Style.Setter could reach at all).
    -->
    <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type ui:TitleBar}}" TargetType="{x:Type ui:TitleBar}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <!--
        Grouping panel: the raised surface every functional zone sits on (status, record bar,
        settings groups). Border gives the depth; no shadows on flat panels.
    -->
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Panel}" />
    </Style>

    <!--  Section heading inside a panel or dialog.  -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.SectionTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Strong}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!--  Label above a form field (dialogs).  -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Label}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--
        The big phrase button, shared by every item on the board (no per-item inline style). BasedOn
        keeps WPF-UI's Fluent template; chrome border is zero on purpose so a hovered tile can't
        imitate the playing ring. Hover feedback is the overlay wash in the tile template; the
        playing ring lives on PhraseTileFillStyle below.
        
        Fixed size (09/mockup, Phase B): tag count or title length must never change the tile's
        footprint or reflow the WrapPanel around it — title clamps, tags cap at VisibleTagChips
        + a "+N" overflow chip instead. Height is 128, not the mockup's literal 106: confirmed by
        rendering a genuinely 2-line-clamped title (using its full height budget) that 106 clips
        the tags row beneath it — the mockup's own reference tiles never exercise that combination
        (title + duration + tags all at once, with a full 2-line title), so its number understated
        the real worst case.
    -->
    <Style
        x:Key="PhraseButtonStyle"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Width" Value="148" />
        <Setter Property="Height" Value="128" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--
        Tile title: 2-line clamp with an ellipsis on overflow (09's "2-line clamp + ellipsis, full
        title in tooltip"). WPF's TextBlock has no MaxLines (that's a WinUI-only property), and
        TextTrimming + TextWrapping="Wrap" does NOT ellipsize a wrapped line either — confirmed by
        rendering the same long title at several MaxHeight values: WPF collapses to single-line-with-
        ellipsis the instant the full wrapped text doesn't fit, never showing 2 full lines first. The
        text itself is pre-clamped by TitleClampConverter (real FormattedText measurement, so it's
        exactly right for this FontSize/FontWeight) — Wrap alone renders it; no TextTrimming needed.
        MaxHeight is a generous safety net only (converter already guarantees <= 2 lines).
    -->
    <Style x:Key="TileTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.SectionTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource Weight.Strong}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxHeight" Value="48" />
    </Style>

    <!--
        Direction A tile: a NEUTRAL raised surface (no more full category fill). The category colour
        is a thin left edge marker set per-tile in the view. BorderThickness is constant so the
        playing ring never shifts layout — the brush swaps from transparent to Accent instead of a
        border appearing. IsCurrentStep (Conversations) sits above IsPlaying so a playing tile wins.
    -->
    <Style x:Key="PhraseTileFillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Style.Triggers>
            <!--  Muted ring on the step the operator is expected to play next (Conversation mode)  -->
            <DataTrigger Binding="{Binding IsCurrentStep}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Text.Secondary}" />
            </DataTrigger>
            <!--  Accent ring + Live tint fill while this phrase is playing (09 "Interaction states").  -->
            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Background" Value="{DynamicResource Status.Live.Tint}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Thin category edge marker for a phrase tile (Direction A). The colour is set per-tile via
        a bound Background in the view; this only fixes geometry/shape.
        
        Phase D "motion": widens on hover (09 "ribbon ScaleX 1->1.6"). RenderTransformOrigin="0,0.5"
        keeps the left edge pinned while it grows right, so it reads as the marker widening rather
        than sliding. IsMouseOver comes from the ancestor ui:Button (this Border isn't itself
        hit-testable/clickable) — same RelativeSource pattern the wash styles below already use.
        Uses an inline QuadraticEase (EaseOut), not KeySpline.Standard: SplineDoubleKeyFrame's
        KeyTime property doesn't accept a Duration-typed resource (KeyTime and Duration are
        unrelated CLR types), so honoring that token here would mean hardcoding a KeyTime literal
        next to a StaticResource Duration — exactly the "ad-hoc duration" drift Tokens.xaml exists
        to prevent. QuadraticEase EaseOut is visually equivalent to 09's "ease-out" intent while
        keeping Duration cleanly tokenized.
    -->
    <Style x:Key="CategoryEdgeMarkerStyle" TargetType="Border">
        <Setter Property="Width" Value="5" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:Button}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.6"
                                Duration="{StaticResource Motion.Base}">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1"
                                Duration="{StaticResource Motion.Base}">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Uniform press-scale on a phrase tile's whole content Grid (09 "Tile press: Scale 0.975,
        120ms" — the tile inner grid transform, distinct from the ribbon's own hover-only widen
        above). RenderTransformOrigin stays the default 0.5,0.5 (center) so the tile shrinks toward
        its own middle. IsPressed also comes from the ancestor ui:Button, same pattern as the wash
        styles below.
    -->
    <Style x:Key="TilePressScaleStyle" TargetType="Grid">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=ui:Button}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="0.975"
                                Duration="{StaticResource Motion.Fast}" />
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="0.975"
                                Duration="{StaticResource Motion.Fast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1"
                                Duration="{StaticResource Motion.Fast}" />
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1"
                                Duration="{StaticResource Motion.Fast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Static brand-green CTA (the board's empty-state "Record"/"Record into…" buttons — always
        the commit/ready look, never switching state, unlike EngineToggleButtonStyle below). Skips
        Appearance="Primary" for the same reason as that style: WPF-UI's accent-tint ramp washes our
        light brand green to near-white (Phase B finding, see Tokens.Dark.xaml's Accent comment).
    -->
    <Style
        x:Key="BrandCtaButtonStyle"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Background" Value="{DynamicResource Brand.Gradient}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--
        MainWindow's engine Start/Stop toggle. Extracted from an inline style (Phase A, brand
        redesign) so future phases are token/style-only. Content/icon stay local on the button —
        only Appearance/Background/Command are style-owned, matching PhraseButtonStyle's own
        local-vs-style split above.
        
        Start state sets Background/Foreground directly against Brand.Gradient instead of
        Appearance="Primary" (Phase B finding): WPF-UI's Fluent accent-tint ramp assumes a
        moderate-lightness base accent (e.g. Windows blue #0078D4); our brand green (#7BC96A) is
        already light, so the generated "AccentFillColorDefaultBrush" washes out to near-white
        (confirmed via a live ui:Button + resource dump — SystemAccentColor correctly tracked our
        green, but AccentFillColorDefault/Secondary/Tertiary did not). The mockup's own "WPF
        fidelity note" anticipated this exact mismatch. The two DataTriggers below are mutually
        exclusive (IsEngineRunning is a bool) so neither state's Setters bleed into the other —
        no unconditioned base Setter for Background/Foreground to leak past the trigger.
    -->
    <Style
        x:Key="EngineToggleButtonStyle"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status.IsEngineRunning}" Value="False">
                <Setter Property="Command" Value="{Binding StartEngineCommand}" />
                <Setter Property="Background" Value="{DynamicResource Brand.Gradient}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.IsEngineRunning}" Value="True">
                <Setter Property="Command" Value="{Binding StopEngineCommand}" />
                <Setter Property="Appearance" Value="Secondary" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Engine-state dot (lives inside the Start/Stop toggle, and reused by StatusPillStyle's own
        dot — one Style, applied to two simultaneously-live elements per window, so both channels
        agree on colour AND motion). Colour tracks Status.State independent of the Start/Stop label.

        Phase D "motion": Live loops a breathe (Opacity 1<->0.5, 1.8 s total via a 0.9 s
        AutoReverse), Degraded loops a hard hard-edged 2-step blink (DiscreteDoubleKeyFrame, no
        easing — 09 "wrong, not on air", distinct from Live's soft breathe). Every looping
        BeginStoryboard is named so ExitActions can StopStoryboard it — stopping removes the
        animated value entirely, so the element falls back to the Style's plain Fill/Opacity
        Setter (no explicit "revert" animation needed). Duration/RepeatBehavior are literal, not
        DynamicResource-tokenized (see the backdrop-crossfade comment above for why: a
        DynamicResource-valued timeline property can't be frozen when a Style.Trigger seals its
        Storyboard).
    -->
    <Style x:Key="StateDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource Status.Stopped}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status.State}" Value="Live">
                <Setter Property="Fill" Value="{DynamicResource Status.Live}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="StateDotLiveBreathe">
                        <Storyboard>
                            <DoubleAnimation
                                AutoReverse="True"
                                RepeatBehavior="Forever"
                                Storyboard.TargetProperty="Opacity"
                                From="1"
                                To="0.5"
                                Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="StateDotLiveBreathe" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.State}" Value="OffAir">
                <Setter Property="Fill" Value="{DynamicResource Status.OffAir}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.State}" Value="Degraded">
                <Setter Property="Fill" Value="{DynamicResource Status.Degraded}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="StateDotDegradedBlink">
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames
                                RepeatBehavior="Forever"
                                Storyboard.TargetProperty="Opacity"
                                Duration="0:0:0.8">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="0.2" />
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="StateDotDegradedBlink" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Recorder dialog's recording-in-progress dot (09 "Recording dot: breathe, loop 1.2 s") —
        same pattern as StateDotStyle's Live breathe above, just its own style since it's driven by
        RecorderViewModel.IsRecording, not Status.State. The DataTrigger's Binding is the same path
        RecorderDialog.xaml already uses for the row's own Visibility, so the Ellipse (a child of
        that row) already inherits the right DataContext — no RelativeSource needed.
    -->
    <Style x:Key="RecordingDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource Status.Degraded}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="RecordingDotBreathe">
                        <Storyboard>
                            <DoubleAnimation
                                AutoReverse="True"
                                RepeatBehavior="Forever"
                                Storyboard.TargetProperty="Opacity"
                                From="1"
                                To="0.5"
                                Duration="0:0:0.6" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="RecordingDotBreathe" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Status pill (09 "the second state channel, never colour alone"): dot + ALL-CAPS label +
        per-state tint background, next to the Start/Stop toggle. Its dot reuses StateDotStyle
        directly so both channels agree on the exact fill colour. LIVE gets a static green glow
        halo (max one glowing element at rest, per 09) that fades in/out (Phase D "motion", 200 ms,
        one-shot — the BREATHE is the dot's job, on StateDotStyle below; the glow itself never
        loops, per 09's motion table). TextElement.* are attached properties Border can set and a
        child TextBlock inherits, even though Border itself has no Foreground/FontWeight of its own.
        
        The DropShadowEffect now lives on the STYLE'S BASE (Opacity="0"), not inside the Live
        trigger's Setter — required, not a style choice: animating (UIElement.Effect).
        (DropShadowEffect.Opacity) needs a non-null Effect to already be present on the element
        before the trigger fires, or the animation silently no-ops. The Live trigger only toggles
        Effect.Opacity via EnterActions/ExitActions; Color/BlurRadius/ShadowDepth stay fixed.
    -->
    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Status.Stopped.Tint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Status.Stopped}" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="16"
                    Opacity="0"
                    ShadowDepth="0"
                    Color="{DynamicResource Status.Live.Color}" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status.State}" Value="Live">
                <Setter Property="Background" Value="{DynamicResource Status.Live.Tint}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Status.Live}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                To="0.55"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                To="0"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.State}" Value="OffAir">
                <Setter Property="Background" Value="{DynamicResource Status.OffAir.Tint}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Status.OffAir}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status.State}" Value="Degraded">
                <Setter Property="Background" Value="{DynamicResource Status.Degraded.Tint}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Status.Degraded}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        OFF AIR toggle: lit amber (Caution) while off air. BasedOn the implicit WPF-UI style: a bare
        local Style would replace it and strip the Fluent chrome entirely.
    -->
    <Style
        x:Key="OffAirButtonStyle"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="ToolTip" Value="Pause the call feed (the call cannot hear you)" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status.IsOffAir}" Value="True">
                <Setter Property="Appearance" Value="Caution" />
                <Setter Property="ToolTip" Value="OFF AIR — the call cannot hear you. Click to go back on air." />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Record button: lit amber (Caution) while a take is waiting to be saved.  -->
    <Style
        x:Key="RecordButtonStyle"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="ToolTip" Value="Record a new phrase (pauses the call feed while recording)" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPendingTake}" Value="True">
                <Setter Property="Appearance" Value="Caution" />
                <Setter Property="ToolTip" Value="A recording is waiting to be saved — click to open it." />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        STOP: brand-red destructive fill. WPF-UI's Appearance="Danger" bakes its color into a
        ControlTemplate trigger (Phase A finding — see Tokens.Dark.xaml's comment) and ignores any
        resource override, so this skips Appearance entirely and sets Background/Foreground directly
        against our own tokens. Disabled state falls back to a neutral surface (mockup ".stopbtn:disabled").
        
        Phase D "motion": a red glow (09 "STOP hover: glow in/out, Effect.Opacity, 200ms") fades in
        while armed and hovered. Base Effect is present at Opacity="0" (same reason as
        StatusPillStyle's LIVE glow above — animating Effect.Opacity against a null Effect
        silently no-ops). A MultiTrigger (IsMouseOver AND IsEnabled), not a plain Trigger on
        IsMouseOver alone, so a disabled STOP never glows even if the mouse happens to be over it
        — "glow only while armed" is a correctness requirement here, not a style preference.
    -->
    <Style
        x:Key="StopButtonStyle"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Background" Value="{DynamicResource Danger.Solid}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Stop}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="20"
                    Opacity="0"
                    ShadowDepth="0"
                    Color="{DynamicResource Danger.Solid.Color}" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Surface.Overlay}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                To="0.6"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                To="0"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Any standalone brand-red destructive button (not a small icon like Categories/Conversations/
        Versions' Danger ✕ — those stay plain Appearance="Danger", fine for a small button among
        siblings). Same workaround as StopButtonStyle above: skip Appearance= entirely (WPF-UI bakes
        it into a ControlTemplate trigger, ignoring resource overrides) and set colors directly.
    -->
    <Style
        x:Key="DangerButtonStyle"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="{x:Type ui:Button}">
        <Setter Property="Background" Value="{DynamicResource Danger.Solid}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Surface.Overlay}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Hover/press wash over a phrase tile, over any category fill. Not hit-testable, so clicks and
        the context menu pass straight through. RelativeSource is evaluated at the usage site, so
        this resolves correctly once keyed here instead of inline.

        Phase D "motion": TWO stacked Borders (used together at the usage site — MainWindow.xaml's
        tile template), not the one this replaced. A single Border whose Background Setter swapped
        color faded IN on hover (a Setter applies instantly) but SNAPPED out just as instantly the
        moment IsMouseOver went false — nothing was left to animate on exit. Each layer here has a
        FIXED tint and animates its OWN Opacity 0<->1 instead, so both directions fade. Order at the
        usage site matters for z-stacking: Hover first, Press second, so if both are true (pressed
        normally implies hovered) the Press wash paints over the Hover wash.
    -->
    <Style x:Key="TileHoverWashStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Overlay.Hover}" />
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:Button}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="{StaticResource Motion.Base}">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                FillBehavior="HoldEnd"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="{StaticResource Motion.Base}">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
