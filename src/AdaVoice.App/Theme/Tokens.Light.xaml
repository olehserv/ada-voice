<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        "Pine Signal" brand redesign (owner-approved 2026-07-18) — LIGHT color tokens. Keys match
        Tokens.Dark.xaml exactly. Text/surface pairs verified >= 4.5:1 (2026-07-18); status colors
        are darkened so pill TEXT stays legible on light tint washes.
        Phase A — token layer only; see Tokens.Dark.xaml's header for the Surface.Window /
        Surface.Window.* split.
    -->

    <!--  Surfaces: cream ramp. Surface.Window is the STOPPED wash's quiet cream stop, kept solid until Phase B.  -->
    <SolidColorBrush x:Key="Surface.Window" Color="#FAF6EF" />
    <SolidColorBrush x:Key="Surface.Raised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface.Overlay" Color="#F0EBDF" />

    <!--  Borders: ink at low alpha so they hold on every surface step.  -->
    <SolidColorBrush x:Key="Border.Subtle" Color="#21221E17" />
    <SolidColorBrush x:Key="Border.Strong" Color="#3D221E17" />

    <!--  Text: all three hold >= 4.5:1 on Surface.Raised, Surface.Window, and Surface.Overlay.  -->
    <SolidColorBrush x:Key="Text.Primary" Color="#221E17" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#55503F" />
    <SolidColorBrush x:Key="Text.Muted" Color="#6B6552" />

    <!--  Status: darkened vs dark theme so the LABEL holds >= 4.5:1 on light surfaces.  -->
    <SolidColorBrush x:Key="Status.Live" Color="#2E5D3A" />
    <SolidColorBrush x:Key="Status.OffAir" Color="#8A5A00" />
    <SolidColorBrush x:Key="Status.Degraded" Color="#B3362C" />
    <SolidColorBrush x:Key="Status.Stopped" Color="#6B6552" />

    <!--  Status tints: pill/tile background wash — same hue as Status.* above, low alpha (ambient, not a fill).  -->
    <SolidColorBrush x:Key="Status.Live.Tint" Color="#1A2E5D3A" />
    <SolidColorBrush x:Key="Status.OffAir.Tint" Color="#1F8A5A00" />
    <SolidColorBrush x:Key="Status.Degraded.Tint" Color="#1AB3362C" />
    <SolidColorBrush x:Key="Status.Stopped.Tint" Color="#146B6552" />

    <!--
        The brand accent, used sparingly: focus, playing ring. Darker than the dark-theme green so
        white button text and the focus ring hold contrast on light surfaces. Stays a
        SolidColorBrush — see Tokens.Dark.xaml's Accent comment.
    -->
    <SolidColorBrush x:Key="Accent" Color="#2E5D3A" />

    <!--
        Filled-green CTA faces. Brand.Gradient is flat in light theme per 09 (both stops equal) —
        same brush type as dark for a uniform DynamicResource contract.
    -->
    <SolidColorBrush x:Key="Brand.Deep" Color="#2E5D3A" />
    <LinearGradientBrush x:Key="Brand.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2E5D3A" />
        <GradientStop Offset="1" Color="#2E5D3A" />
    </LinearGradientBrush>

    <!--  Filled-red destructive/hot actions.  -->
    <SolidColorBrush x:Key="Danger.Solid" Color="#B3362C" />

    <!--  Title-bar hairline — see Tokens.Dark.xaml's comment. Same fixed brand gradient in both themes.  -->
    <LinearGradientBrush x:Key="Brand.Hairline" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#2E7D4F" />
        <GradientStop Offset="0.55" Color="#3E5D3A" />
        <GradientStop Offset="1" Color="#C63C34" />
    </LinearGradientBrush>

    <!--  Plain Color shadows of the tokens above — see Tokens.Dark.xaml's comment.  -->
    <Color x:Key="Danger.Solid.Color">#B3362C</Color>
    <Color x:Key="Status.Live.Color">#2E5D3A</Color>
    <Color x:Key="Status.OffAir.Color">#8A5A00</Color>

    <!--  Interaction overlays: ink at low alpha on light surfaces (pressed dimmer than hover).  -->
    <SolidColorBrush x:Key="Overlay.Hover" Color="#14000000" />
    <SolidColorBrush x:Key="Overlay.Pressed" Color="#0D000000" />

    <!--  Tag-chip scrim: denser than dark theme (76%) so chip text holds AA over white tiles (9.6:1).  -->
    <SolidColorBrush x:Key="Scrim.Tag" Color="#C2000000" />

    <!--
        State-lit window backgrounds — Phase B wires MainWindow.Background to these; no view binds
        them yet. Light "wash": all four converge on the same quiet cream endpoint. Same gradient
        geometry as Tokens.Dark.xaml's Surface.Window.* for a consistent angle across themes.
    -->
    <LinearGradientBrush x:Key="Surface.Window.Live" StartPoint="0,0" EndPoint="0.27,1">
        <GradientStop Offset="0" Color="#F3F7EE" />
        <GradientStop Offset="1" Color="#FAF6EF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Surface.Window.OffAir" StartPoint="0,0" EndPoint="0.27,1">
        <GradientStop Offset="0" Color="#FAF3E3" />
        <GradientStop Offset="1" Color="#FAF6EF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Surface.Window.Degraded" StartPoint="0,0" EndPoint="0.27,1">
        <GradientStop Offset="0" Color="#FAEFEC" />
        <GradientStop Offset="1" Color="#FAF6EF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Surface.Window.Stopped" StartPoint="0,0" EndPoint="0.27,1">
        <GradientStop Offset="0" Color="#F7F5F0" />
        <GradientStop Offset="1" Color="#FAF6EF" />
    </LinearGradientBrush>

    <!--  Radial bloom, top-left, one per state (STOPPED has none) — see Tokens.Dark.xaml's comment. Fainter than dark theme so it stays ambient on a light wash.  -->
    <RadialGradientBrush x:Key="Bloom.Live">
        <GradientStop Offset="0" Color="#122E5D3A" />
        <GradientStop Offset="1" Color="#002E5D3A" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Bloom.OffAir">
        <GradientStop Offset="0" Color="#0F8A5A00" />
        <GradientStop Offset="1" Color="#008A5A00" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Bloom.Degraded">
        <GradientStop Offset="0" Color="#0FB3362C" />
        <GradientStop Offset="1" Color="#00B3362C" />
    </RadialGradientBrush>

</ResourceDictionary>
