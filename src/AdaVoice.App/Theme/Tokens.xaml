<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- THEME-INVARIANT tokens (Direction A "Studio Graphite", redesign 2026-07-11). These do not
         change between light and dark. All COLOR tokens live in Tokens.Dark.xaml / Tokens.Light.xaml
         (identical keys, swapped at runtime by App). A view uses only tokens — no hex, no raw sizes. -->

    <!-- Typography scale. Weight hierarchy: titles 600, body 400. Floor: nothing below 12;
         status elements never below 14. Font family stays the native Segoe UI Variable. -->
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.SectionTitle">16</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Label">12</sys:Double>

    <!-- Font weights (previously inline in views — now one place). -->
    <FontWeight x:Key="Weight.Regular">Normal</FontWeight>
    <FontWeight x:Key="Weight.Strong">SemiBold</FontWeight>

    <!-- Spacing (4 px grid). Was scattered as literal margins across dialogs. -->
    <Thickness x:Key="Space.DialogContent">16,8,16,16</Thickness>
    <Thickness x:Key="Space.ButtonRow">0,16,0,0</Thickness>
    <Thickness x:Key="Pad.Panel">14,12</Thickness>

    <!-- Shape. One radius scale, no ad-hoc radii: Small = chips/swatches, Control = buttons/inputs/
         tiles, Panel = grouping panels/cards, Pill = status pill. -->
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">12</CornerRadius>

</ResourceDictionary>
