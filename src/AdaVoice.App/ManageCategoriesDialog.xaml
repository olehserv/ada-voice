<ui:FluentWindow x:Class="AdaVoice.App.ManageCategoriesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Manage categories"
        Width="440" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{DynamicResource Surface.Window}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="{StaticResource FontSize.Body}">
    <Window.Resources>
        <!-- One dropdown row: a colour square + its hex. The item's DataContext is the hex string. -->
        <DataTemplate x:Key="ColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="16" Height="16" CornerRadius="{StaticResource Radius.Small}" VerticalAlignment="Center"
                        Background="{Binding Converter={StaticResource HexToBrush}}" />
                <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Manage categories" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <StackPanel Grid.Row="1" Margin="{StaticResource Space.DialogContent}">
        <!-- Existing categories: edit name/colour inline; the default is protected (no Delete) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" VerticalAlignment="Center"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="1" Width="130" Margin="8,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding ColorOptions}"
                                      SelectedItem="{Binding Color, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource ColorItemTemplate}" />
                            <ui:Button Grid.Column="2" Content="Save" Appearance="Secondary" Margin="8,0,0,0"
                                       Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}" />
                            <ui:Button Grid.Column="3" Content="Delete" Appearance="Danger" Margin="8,0,0,0"
                                       Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.Style>
                                    <!-- BasedOn keeps the Fluent chrome — a bare Style would strip it,
                                         leaving a raw grey button (only this one lacked it). -->
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add a new category -->
        <Border Style="{StaticResource PanelStyle}" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" PlaceholderText="New category name" VerticalAlignment="Center"
                            Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" Width="130" Margin="8,0,0,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Palette}"
                          SelectedItem="{Binding NewColor, Mode=TwoWay}"
                          ItemTemplate="{StaticResource ColorItemTemplate}" />
                <ui:Button Grid.Column="2" Content="Add" Appearance="Primary" Margin="8,0,0,0"
                           Command="{Binding AddCommand}" />
            </Grid>
        </Border>

        <ui:Button Content="Done" Appearance="Secondary" IsCancel="True"
                   HorizontalAlignment="Right" Margin="{StaticResource Space.ButtonRow}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
