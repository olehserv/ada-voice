<Window x:Class="AdaVoice.App.ManageCategoriesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Manage categories"
        Width="420" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Surface.Window}"
        TextElement.Foreground="{StaticResource Text.Primary}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
    <Window.Resources>
        <!-- One clickable colour swatch: a coloured square that shows a white ring when it is the
             current choice. Defined here (not in App.xaml) so the app-level colour converters are
             already registered when this dialog is parsed. -->
        <ControlTemplate x:Key="ColorSwatchTemplate" TargetType="Button">
            <Border CornerRadius="4" BorderThickness="2"
                    Background="{Binding Converter={StaticResource HexToBrush}}">
                <Border.BorderBrush>
                    <MultiBinding Converter="{StaticResource SwatchRing}">
                        <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                        <Binding />
                    </MultiBinding>
                </Border.BorderBrush>
            </Border>
        </ControlTemplate>
    </Window.Resources>
    <StackPanel Margin="16">
        <!-- Existing categories: edit name/colour inline; the default is protected (no Delete) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" VerticalAlignment="Center"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <ItemsControl Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding Palette}" Tag="{Binding Color}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Width="104" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Template="{StaticResource ColorSwatchTemplate}"
                                                Width="22" Height="22" Margin="2" Cursor="Hand" ToolTip="{Binding}"
                                                Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Grid.Column="2" Content="Save" Appearance="Secondary" Margin="8,0,0,0"
                                       Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}" />
                            <ui:Button Grid.Column="3" Content="Delete" Appearance="Secondary" Margin="8,0,0,0"
                                       Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add a new category -->
        <Border Background="{StaticResource Surface.Raised}" CornerRadius="{StaticResource Radius.Control}"
                Padding="{StaticResource Pad.Control}" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" PlaceholderText="New category name" VerticalAlignment="Center"
                            Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                <ItemsControl Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Palette}" Tag="{Binding NewColor}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Width="104" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Template="{StaticResource ColorSwatchTemplate}"
                                    Width="22" Height="22" Margin="2" Cursor="Hand" ToolTip="{Binding}"
                                    Command="{Binding DataContext.PickNewColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Grid.Column="2" Content="Add" Appearance="Primary" Margin="8,0,0,0"
                           Command="{Binding AddCommand}" />
            </Grid>
        </Border>

        <ui:Button Content="Done" Appearance="Secondary" IsCancel="True"
                   HorizontalAlignment="Right" Margin="0,16,0,0" />
    </StackPanel>
</Window>
