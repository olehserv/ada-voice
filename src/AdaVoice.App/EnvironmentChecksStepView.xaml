<UserControl
    x:Class="AdaVoice.App.EnvironmentChecksStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:AdaVoice.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.EnvChecks_Title}" />

        <!--
            Brief spinner shown before results appear. The checks actually run instantly — this is
            a deliberate cosmetic pause (design 05 §2: "each row: spinner → ✓/✗").
            Swapped for ChecksList by the timer in EnvironmentChecksStepView.xaml.cs.
        -->
        <StackPanel
            x:Name="SpinnerPanel"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <ProgressBar
                Width="16"
                Height="16"
                IsIndeterminate="True" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Text.Secondary}"
                Text="{x:Static res:Strings.EnvChecks_Checking}" />
        </StackPanel>

        <ItemsControl
            x:Name="ChecksList"
            ItemsSource="{Binding Checks}"
            Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Converter={StaticResource EnvCheckToTitle}}" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding Status, Converter={StaticResource CheckStatusToLabel}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Degraded}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                    <Setter Property="Foreground" Value="{DynamicResource Status.Live}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource Text.Secondary}"
                                Text="{Binding Converter={StaticResource EnvCheckToDetail}}"
                                TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Visibility="{Binding Converter={StaticResource FailedCableCheckToLink}}">
                                <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="OnVbCableLinkRequestNavigate">
                                    <Run Text="{x:Static res:Strings.EnvChecks_DownloadVbCable}" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ui:Button
            HorizontalAlignment="Left"
            Appearance="Secondary"
            Command="{Binding RecheckCommand}"
            Content="{x:Static res:Strings.EnvChecks_Recheck}" />
    </StackPanel>
</UserControl>
