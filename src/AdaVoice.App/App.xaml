<Application x:Class="AdaVoice.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:AdaVoice.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI Fluent theme + control styles first, then our brand tokens override. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Theme/Tokens.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Colour converters (category fill + readable text + selected-swatch ring). -->
            <app:HexToBrushConverter x:Key="HexToBrush" />
            <app:ContrastTextConverter x:Key="ContrastText" />
            <app:SwatchRingConverter x:Key="SwatchRing" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
