<ui:FluentWindow x:Class="AdaVoice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AdaVoice"
        Width="480" Height="640" MinWidth="420" MinHeight="560"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{StaticResource Surface.Window}"
        TextElement.Foreground="{StaticResource Text.Primary}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Esc = panic stop from anywhere in the window (the global hotkey covers other apps).
         ComboBox/menu popups handle Esc themselves first, so this never fights them. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent title bar (compact tool: no maximize) -->
        <ui:TitleBar Grid.Row="0" Title="AdaVoice" ShowMaximize="False" CanMaximize="False" />

        <Grid Grid.Row="1" Margin="12,4,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status panel: state pill + error on the first row, engine controls below,
             window-level actions (setup/settings) top-right as quiet icon buttons. -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Engine state pill: colored dot + label, tinted wash per state. The dot plus
                         the ALL-CAPS label mean state is never conveyed by color alone. -->
                    <Border Grid.Column="0" CornerRadius="{StaticResource Radius.Pill}" Padding="10,4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Status.StateLabel}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Status.Stopped.Tint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.State}" Value="Live">
                                        <Setter Property="Background" Value="{StaticResource Status.Live.Tint}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status.State}" Value="OffAir">
                                        <Setter Property="Background" Value="{StaticResource Status.OffAir.Tint}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status.State}" Value="Degraded">
                                        <Setter Property="Background" Value="{StaticResource Status.Degraded.Tint}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Status.Stopped}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.State}" Value="Live">
                                                <Setter Property="Fill" Value="{StaticResource Status.Live}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.State}" Value="OffAir">
                                                <Setter Property="Fill" Value="{StaticResource Status.OffAir}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.State}" Value="Degraded">
                                                <Setter Property="Fill" Value="{StaticResource Status.Degraded}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Status.StateLabel}" FontWeight="SemiBold"
                                       Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.State}" Value="Live">
                                                <Setter Property="Foreground" Value="{StaticResource Status.Live}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.State}" Value="OffAir">
                                                <Setter Property="Foreground" Value="{StaticResource Status.OffAir}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.State}" Value="Degraded">
                                                <Setter Property="Foreground" Value="{StaticResource Status.Degraded}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Why the engine landed here (e.g. a failed Start's reason). Empty = invisible. -->
                    <TextBlock Grid.Column="1" Text="{Binding Status.StateError}"
                               Foreground="{StaticResource Status.Degraded}"
                               VerticalAlignment="Center" Margin="10,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Status.StateError}" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button Appearance="Transparent" BorderThickness="0" Padding="6"
                                   Icon="{ui:SymbolIcon Wrench24}"
                                   Command="{Binding RunSetupCommand}"
                                   ToolTip="Run setup again" AutomationProperties.Name="Setup" />
                        <ui:Button Appearance="Transparent" BorderThickness="0" Padding="6" Margin="4,0,0,0"
                                   Icon="{ui:SymbolIcon Settings24}"
                                   Command="{Binding RunSettingsCommand}"
                                   ToolTip="Settings" AutomationProperties.Name="Settings" />
                    </StackPanel>
                </Grid>

                <!-- Engine controls. Start is the one primary action while stopped. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button Content="Start" Appearance="Primary" Command="{Binding StartEngineCommand}"
                               IsEnabled="{Binding Status.CanStart}" />
                    <ui:Button Content="Stop engine" Appearance="Secondary" Command="{Binding StopEngineCommand}" Margin="8,0,0,0"
                               IsEnabled="{Binding Status.IsEngineRunning}" />
                    <!-- A toggle must show its own state: lit amber (Caution) while off air.
                         The banner this replaced (owner call, 2026-07-06) lives in git history. -->
                    <ui:Button Content="OFF AIR" Command="{Binding ToggleOffAirCommand}" Margin="8,0,0,0"
                               IsEnabled="{Binding Status.IsEngineRunning}">
                        <ui:Button.Style>
                            <!-- BasedOn the implicit WPF-UI style: a bare local Style would replace
                                 it and strip the Fluent chrome entirely. -->
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary" />
                                <Setter Property="ToolTip" Value="Pause the call feed (the call cannot hear you)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.IsOffAir}" Value="True">
                                        <Setter Property="Appearance" Value="Caution" />
                                        <Setter Property="ToolTip" Value="OFF AIR — the call cannot hear you. Click to go back on air." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search + category filter, then the phrase buttons / welcome / no-match states -->
        <Grid Grid.Row="1" Margin="0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search on its own line, filters below it as two compact menu buttons (not dropdowns) —
             keeps the row narrow enough for the docked width (design:
             docs/superpowers/specs/2026-07-07-filter-controls-redesign.md). -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8"
              Visibility="{Binding HasPhrases, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search title or tags…  (Ctrl+F)"
                            Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Grid.Column="1" Margin="4,0,0,0" Appearance="Transparent" BorderThickness="0"
                           Padding="6" VerticalAlignment="Center"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           Command="{Binding ClearSearchCommand}" ToolTip="Clear search"
                           AutomationProperties.Name="Clear search"
                           Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="{Binding CategoryFilterButtonLabel}"
                           Click="ShowCategoryFilterMenu"
                           ToolTip="Filter by category, or manage categories"
                           AutomationProperties.Name="Category filter" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding ConversationFilterButtonLabel}"
                           Click="ShowConversationFilterMenu"
                           ToolTip="Filter by conversation, or manage conversations"
                           AutomationProperties.Name="Conversation filter" />
                <!-- Starts a take immediately and opens the recorder window (BoardViewModel calls
                     back into MainWindow.ShowRecorder). With a take already waiting, it reopens
                     the recorder instead — the lit Caution state says something is unfinished. -->
                <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Mic24}"
                           Content="Record" Command="{Binding StartRecordingCommand}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Secondary" />
                            <Setter Property="ToolTip" Value="Record a new phrase (pauses the call feed while recording)" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingTake}" Value="True">
                                    <Setter Property="Appearance" Value="Caution" />
                                    <Setter Property="ToolTip" Value="A recording is waiting to be saved — click to open it." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
        <!-- Toasts pop in the bottom-right of the board area — never over the STOP zone. -->
        <ui:SnackbarPresenter x:Name="RootSnackbar" Panel.ZIndex="1"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              MaxWidth="380" />
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasMatches, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding PhrasesView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Tag carries the board VM so the context-menu items (outside the visual tree)
                             can reach EditCommand/DeleteCommand; CommandParameter is the phrase item. -->
                        <!-- The category-colour fill lives on our own inner Border (not the ui:Button
                             Background) so WPF-UI's hover/press states can't wash it out; hover and
                             press feedback comes from the overlay Border painted on top instead. -->
                        <ui:Button CommandParameter="{Binding}"
                                   Background="Transparent" CornerRadius="{StaticResource Radius.Control}"
                                   Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource PhraseButtonStyle}">
                                    <!-- The button stays enabled even when the engine is stopped or the audio
                                         is missing: the left-click action is gated in the view-model, and a
                                         disabled control would swallow its own right-click menu. A broken
                                         phrase is only dimmed (visual), so Edit/Delete/Test still work. -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Test on headphones"
                                              Command="{Binding PlacementTarget.Tag.TestOnHeadphonesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Edit…"
                                              Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Delete"
                                              Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <!-- Full-bleed fill = the category colour; every text mark uses the same
                                 auto-contrast (black/white) brush so nothing goes illegible on a fill. -->
                            <Grid>
                                <Border Style="{StaticResource PhraseTileFillStyle}"
                                        Background="{Binding CategoryColor, Converter={StaticResource HexToBrush}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSize.SectionTitle}"
                                                   TextWrapping="Wrap" MaxWidth="170"
                                                   Foreground="{Binding CategoryColor, Converter={StaticResource ContrastText}}" />
                                        <TextBlock Text="{Binding DurationLabel}" Typography.NumeralAlignment="Tabular"
                                                   FontSize="{StaticResource FontSize.Label}" Opacity="0.75" Margin="0,6,0,0"
                                                   Foreground="{Binding CategoryColor, Converter={StaticResource ContrastText}}" />
                                        <TextBlock Text="⚠ audio missing" FontSize="{StaticResource FontSize.Label}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{Binding CategoryColor, Converter={StaticResource ContrastText}}"
                                                   Visibility="{Binding IsBroken, Converter={StaticResource BoolToVis}}" />

                                        <!-- Tag chips: the tag's colour lives on the border (its identity);
                                             the text stays primary-on-scrim so a dark tag colour can never
                                             make its own name unreadable. -->
                                        <ItemsControl ItemsSource="{Binding TagChips}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="{StaticResource Radius.Small}" BorderThickness="1"
                                                            Margin="0,0,4,4" Padding="6,1"
                                                            Background="{StaticResource Scrim.Tag}"
                                                            BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize.Label}"
                                                                   Foreground="{StaticResource Text.Primary}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <!-- Hover/press feedback over any category fill. Not hit-testable, so
                                     clicks and the context menu pass straight through it. -->
                                <Border CornerRadius="{StaticResource Radius.Control}" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ui:Button}}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Overlay.Hover}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=ui:Button}}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Overlay.Pressed}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- First run: nudge the operator to record their first phrase -->
        <ui:Card VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" MaxWidth="320"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Your phrase board is empty" HorizontalAlignment="Center"
                           FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold" />
                <TextBlock Text="Record your first phrase — it takes about 30 seconds."
                           Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,16" />
                <ui:Button Content="Record" Appearance="Primary" HorizontalAlignment="Center"
                           Command="{Binding StartRecordingCommand}" />
            </StackPanel>
        </ui:Card>

        <!-- Exactly one category is checked and it genuinely has no phrases (search is blank) —
             distinct from the search-driven no-match card below and from the 2+-checked generic
             card after it. EffectiveSingleCategoryName is only non-null in this exact condition. -->
        <ui:Card VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" MaxWidth="320"
                 Visibility="{Binding CategoryIsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold">
                    <Run Text="No phrases in " /><Run Text="{Binding EffectiveSingleCategoryName, Mode=OneWay}" /><Run Text=" yet." />
                </TextBlock>
                <ui:Button Appearance="Primary" HorizontalAlignment="Center" Margin="0,12,0,0"
                           Command="{Binding RecordIntoCategoryCommand}">
                    <TextBlock><Run Text="Record into " /><Run Text="{Binding EffectiveSingleCategoryName, Mode=OneWay}" /></TextBlock>
                </ui:Button>
            </StackPanel>
        </ui:Card>

        <!-- 2+ categories are checked and none of them has a matching phrase — no single target to
             record into, so this is a plain message, not a CTA (distinct from CategoryIsEmpty above). -->
        <ui:Card VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" MaxWidth="320"
                 Visibility="{Binding MultipleCategoriesNoMatch, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="No phrases match the checked categories" HorizontalAlignment="Center"
                           FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </ui:Card>

        <!-- A search is active and matches nothing (distinct from first-run and from
             CategoryIsEmpty above). SearchText has a public setter, so Mode=OneWay isn't strictly
             required here for correctness — added anyway for consistency with the Global
             Constraints rule and to make every new Run in this file follow the same rule. -->
        <ui:Card VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" MaxWidth="320"
                 Visibility="{Binding SearchNoMatch, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold">
                    <Run Text="No phrases match '" /><Run Text="{Binding SearchText, Mode=OneWay}" /><Run Text="'" />
                </TextBlock>
                <ui:Button Content="Clear search" Appearance="Secondary" HorizontalAlignment="Center"
                           Command="{Binding ClearSearchCommand}" Margin="0,12,0,0" />
            </StackPanel>
        </ui:Card>

        <!-- A conversation is active and none of its phrases are on the board (distinct from
             CategoryIsEmpty, which this can never overlap with — see BoardViewModel.ConversationIsEmpty). -->
        <ui:Card VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" MaxWidth="320"
                 Visibility="{Binding ConversationIsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold">
                    <Run Text="No phrases in " /><Run Text="{Binding SelectedConversationFilter.Name, Mode=OneWay}" /><Run Text=" yet." />
                </TextBlock>
                <TextBlock Text="Add phrases to it from Conversations…" TextWrapping="Wrap"
                           TextAlignment="Center" Foreground="{StaticResource Text.Secondary}" Margin="0,8,0,0" />
            </StackPanel>
        </ui:Card>
        </Grid>
        </Grid>

        <!-- Big STOP, with a hint of the global stop hotkey just below it.
             HotkeyHint text + visibility are set in code-behind once the key is registered.
             (Recording moved to the modal RecorderDialog — the Record button in the filter row
             and the empty-state cards open it.) -->
        <StackPanel Grid.Row="2">
            <ui:Button Content="STOP" Appearance="Danger" Command="{Binding StopCommand}"
                       IsEnabled="{Binding Status.IsEngineRunning}"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                       Height="56" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" />
            <TextBlock x:Name="HotkeyHint" HorizontalAlignment="Center" Margin="0,6,0,0"
                       Visibility="Collapsed"
                       Foreground="{StaticResource Text.Muted}"
                       FontSize="{StaticResource FontSize.Label}" />
        </StackPanel>
        </Grid>

    </Grid>
</ui:FluentWindow>
