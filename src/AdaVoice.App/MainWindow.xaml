<ui:FluentWindow x:Class="AdaVoice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AdaVoice"
        Width="480" Height="640" MinWidth="420" MinHeight="560"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{StaticResource Surface.Window}"
        TextElement.Foreground="{StaticResource Text.Primary}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent title bar (compact tool: no maximize) -->
        <ui:TitleBar Grid.Row="0" Title="AdaVoice" ShowMaximize="False" CanMaximize="False" />

        <Grid Grid.Row="1" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- OFF AIR banner: shown while recording (the call feed is paused) -->
        <Border Grid.Row="0" Background="{StaticResource Status.OffAir}" CornerRadius="{StaticResource Radius.Control}"
                Padding="12,6" Margin="0,0,0,8"
                Visibility="{Binding Status.IsOffAir, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="OFF AIR — recording (the call cannot hear you)" Foreground="#1F1F1F"
                       FontWeight="SemiBold" HorizontalAlignment="Center" />
        </Border>

        <!-- Status bar: engine state + engine controls -->
        <Border Grid.Row="1" Background="{StaticResource Surface.Raised}" CornerRadius="{StaticResource Radius.Control}"
                Padding="{StaticResource Pad.Control}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Status.StateLabel}" FontWeight="SemiBold"
                           FontSize="{StaticResource FontSize.SectionTitle}"
                           VerticalAlignment="Center" MinWidth="90" />
                <ui:Button Content="Start" Appearance="Secondary" Command="{Binding StartEngineCommand}" Margin="8,0,0,0"
                           IsEnabled="{Binding Status.CanStart}" />
                <ui:Button Content="Stop engine" Appearance="Secondary" Command="{Binding StopEngineCommand}" Margin="8,0,0,0"
                           IsEnabled="{Binding Status.IsEngineRunning}" />
                <ui:Button Content="OFF AIR" Appearance="Secondary" Command="{Binding ToggleOffAirCommand}" Margin="8,0,0,0"
                           IsEnabled="{Binding Status.IsEngineRunning}" />
                <ui:Button Content="Setup…" Appearance="Secondary" Command="{Binding RunSetupCommand}" Margin="8,0,0,0" />
                <ui:Button Content="Settings…" Appearance="Secondary" Command="{Binding RunSettingsCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Search + category filter, then the phrase buttons / welcome / no-match states -->
        <Grid Grid.Row="2" Margin="0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search box + category filter — hidden until the board has at least one phrase -->
        <Grid Grid.Row="0" Margin="0,0,0,8"
              Visibility="{Binding HasPhrases, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="Search title or tags…"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="150" VerticalAlignment="Center"
                      ItemsSource="{Binding CategoryFilterOptions}"
                      SelectedItem="{Binding SelectedCategoryFilter}"
                      DisplayMemberPath="Name" />
            <ui:Button Grid.Column="2" Margin="8,0,0,0" Appearance="Secondary"
                       Content="Categories…" Command="{Binding ManageCategoriesCommand}"
                       ToolTip="Add, rename, or delete categories" />
        </Grid>

        <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasMatches, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding PhrasesView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Tag carries the board VM so the context-menu items (outside the visual tree)
                             can reach EditCommand/DeleteCommand; CommandParameter is the phrase item. -->
                        <!-- Padding 0 + stretched content so the category-colour Border fills the whole
                             tile. The fill lives on our own Border (not the ui:Button Background) so it is
                             immune to WPF-UI's hover/press appearance states. -->
                        <ui:Button CommandParameter="{Binding}" Padding="0"
                                   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                   Background="Transparent" CornerRadius="{StaticResource Radius.Control}"
                                   Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource PhraseButtonStyle}">
                                    <!-- The button stays enabled even when the engine is stopped or the audio
                                         is missing: the left-click action is gated in the view-model, and a
                                         disabled control would swallow its own right-click menu. A broken
                                         phrase is only dimmed (visual), so Edit/Delete/Test still work. -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Test on headphones"
                                              Command="{Binding PlacementTarget.Tag.TestOnHeadphonesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Edit…"
                                              Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Delete"
                                              Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <!-- Full-bleed fill = the category colour; every text mark uses the same
                                 auto-contrast (black/white) brush so nothing goes illegible on a fill. -->
                            <Border CornerRadius="{StaticResource Radius.Control}" Padding="12"
                                    Background="{Binding CategoryColor, Converter={StaticResource HexToBrush}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSize.SectionTitle}"
                                               TextWrapping="Wrap" MaxWidth="170"
                                               Foreground="{Binding CategoryColor, Converter={StaticResource ContrastText}}" />
                                    <TextBlock Text="{Binding DurationLabel}"
                                               FontSize="{StaticResource FontSize.Label}" Opacity="0.75" Margin="0,6,0,0"
                                               Foreground="{Binding CategoryColor, Converter={StaticResource ContrastText}}" />
                                    <TextBlock Text="⚠ audio missing" FontSize="{StaticResource FontSize.Label}"
                                               Margin="0,4,0,0"
                                               Foreground="{Binding CategoryColor, Converter={StaticResource ContrastText}}"
                                               Visibility="{Binding IsBroken, Converter={StaticResource BoolToVis}}" />

                                    <!-- Tag chips: colour border + colour text on a fixed dark scrim, so
                                         they stay legible over any category fill (not just the neutral one). -->
                                    <ItemsControl ItemsSource="{Binding TagChips}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" BorderThickness="1" Margin="0,0,4,4" Padding="6,1"
                                                        Background="#66000000"
                                                        BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize.Label}"
                                                               Foreground="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- First run: nudge the operator to record their first phrase -->
        <ui:Card VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" MaxWidth="320"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Your phrase board is empty" HorizontalAlignment="Center"
                           FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold" />
                <TextBlock Text="Record your first phrase — it takes about 30 seconds."
                           Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,16" />
                <ui:Button Content="Record" Appearance="Primary" HorizontalAlignment="Center"
                           Command="{Binding StartRecordingCommand}" />
            </StackPanel>
        </ui:Card>

        <!-- Phrases exist, but the current search/filter hides them all (distinct from first-run) -->
        <ui:Card VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" MaxWidth="320"
                 Visibility="{Binding NoMatches, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="No phrases match" HorizontalAlignment="Center"
                           FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="SemiBold" />
                <TextBlock Text="Try a different search or category."
                           Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </ui:Card>
        </Grid>
        </Grid>

        <!-- Record area -->
        <Border Grid.Row="3" Background="{StaticResource Surface.Raised}" CornerRadius="{StaticResource Radius.Control}"
                Padding="{StaticResource Pad.Control}" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- Idle: offer to record (hidden while recording or while a take is pending) -->
                    <ui:Button Content="Record" Appearance="Primary"
                               Command="{Binding StartRecordingCommand}"
                               Visibility="{Binding ShowRecordButton, Converter={StaticResource BoolToVis}}" />

                    <!-- Recording -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Recording…" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <ui:Button Content="Stop" Appearance="Secondary" Command="{Binding StopRecordingCommand}" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- A take is waiting to be saved -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasPendingTake, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PendingTakeDurationLabel}"
                                   VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}" />
                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Width="160"
                                 Margin="8,0,0,0" VerticalAlignment="Center" />
                        <ui:Button Content="Preview" Appearance="Secondary" Command="{Binding PreviewTakeCommand}" Margin="8,0,0,0" />
                        <ui:Button Content="Save" Appearance="Secondary" Command="{Binding SaveTakeCommand}" Margin="8,0,0,0" />
                        <ui:Button Content="Discard" Appearance="Secondary" Command="{Binding DiscardTakeCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Text.Secondary}"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Big STOP, with a hint of the global stop hotkey just below it.
             HotkeyHint text + visibility are set in code-behind once the key is registered. -->
        <StackPanel Grid.Row="4">
            <ui:Button Content="STOP" Appearance="Danger" Command="{Binding StopCommand}"
                       IsEnabled="{Binding Status.IsEngineRunning}"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                       Height="56" FontSize="{StaticResource FontSize.Title}" FontWeight="Bold" />
            <TextBlock x:Name="HotkeyHint" HorizontalAlignment="Center" Margin="0,6,0,0"
                       Visibility="Collapsed"
                       Foreground="{StaticResource Text.Secondary}"
                       FontSize="{StaticResource FontSize.Label}" />
        </StackPanel>
        </Grid>

        <!-- Toasts float above the board -->
        <ui:SnackbarPresenter Grid.Row="1" x:Name="RootSnackbar" />
    </Grid>
</ui:FluentWindow>
