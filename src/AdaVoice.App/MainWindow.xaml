<Window x:Class="AdaVoice.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdaVoice" Topmost="True"
        Width="480" Height="640" MinWidth="420" MinHeight="560"
        Background="{StaticResource Surface.Window}"
        TextElement.Foreground="{StaticResource Text.Primary}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status bar: engine state + engine controls -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Raised}" CornerRadius="4" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Status.StateLabel}" FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" MinWidth="90" />
                <Button Content="Start" Command="{Binding StartEngineCommand}" Margin="8,0,0,0" Padding="12,4" />
                <Button Content="Stop engine" Command="{Binding StopEngineCommand}" Margin="8,0,0,0" Padding="12,4" />
                <Button Content="OFF AIR" Command="{Binding ToggleOffAirCommand}" Margin="8,0,0,0" Padding="12,4" />
            </StackPanel>
        </Border>

        <!-- Phrase buttons: click plays the phrase to the call -->
        <ScrollViewer Grid.Row="1" Margin="0,12" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Phrases}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button MinWidth="150" MinHeight="96" Margin="4"
                                Background="{StaticResource Surface.Raised}"
                                Foreground="{StaticResource Text.Primary}"
                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"
                                           TextWrapping="Wrap" MaxWidth="170" />
                                <TextBlock Text="{Binding DurationMs, StringFormat='{}{0} ms'}" FontSize="12"
                                           Foreground="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Big STOP -->
        <Button Grid.Row="2" Content="STOP" Command="{Binding StopCommand}"
                Height="56" FontSize="20" FontWeight="Bold"
                Background="{StaticResource Status.Degraded}" Foreground="#1F1F1F" BorderThickness="0" />
    </Grid>
</Window>
