<UserControl
    x:Class="AdaVoice.App.InstructionStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:AdaVoice.App.Resources">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Instruction_Title}" />
        <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="{Binding}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
