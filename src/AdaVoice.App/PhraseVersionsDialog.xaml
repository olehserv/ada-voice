<ui:FluentWindow
    x:Class="AdaVoice.App.PhraseVersionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title, StringFormat='Versions — {0}'}"
    Width="480"
    MaxHeight="560"
    Background="{DynamicResource Surface.Window}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI Variable, Segoe UI"
    FontSize="{StaticResource FontSize.Body}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    TextElement.Foreground="{DynamicResource Text.Primary}"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="{Binding Title, StringFormat='Versions — {0}'}"
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1">
            <!--  Toasts pop in the bottom-right of the window — mirrors MainWindow's RootSnackbar.  -->
            <ui:SnackbarPresenter
                x:Name="RootSnackbar"
                MaxWidth="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Panel.ZIndex="1" />
            <StackPanel Margin="{StaticResource Space.DialogContent}">
                <!--  A board-like tile grid: the primary recording first, then every alternate take.  -->
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="150"
                                    MinHeight="96"
                                    Margin="4"
                                    Padding="10"
                                    Background="{DynamicResource Surface.Overlay}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Control}">
                                    <StackPanel>
                                        <!--
                                            Read-only for the primary tile — its label is fixed ("Primary"),
                                            never persisted; a version's label renames on focus loss.
                                        -->
                                        <TextBox
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            IsEnabled="{Binding IsWritable}"
                                            IsReadOnly="{Binding IsPrimary}"
                                            Text="{Binding Label, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="{StaticResource FontSize.Label}"
                                            Opacity="0.75"
                                            Text="{Binding DurationLabel}"
                                            Typography.NumeralAlignment="Tabular" />
                                        <!--  Shown only when this tile's audio file is missing (finding 5).  -->
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="{StaticResource FontSize.Label}"
                                            Foreground="{DynamicResource Status.Degraded}"
                                            Text="⚠ audio missing"
                                            Visibility="{Binding IsBroken, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <!--
                                                Doubles as Stop while this tile is playing (PlayCommand
                                                toggles on PhraseVersionRowViewModel.IsPlaying).
                                            -->
                                            <ui:Button
                                                Appearance="Secondary"
                                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                                <ui:Button.Style>
                                                    <!--
                                                        Content/ToolTip must be Setters here, not local values on
                                                        the element — a local value outranks a Style.Triggers
                                                        Setter in WPF's property precedence, so the trigger below
                                                        would silently never apply otherwise.
                                                    -->
                                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                        <Setter Property="Content" Value="▶" />
                                                        <Setter Property="ToolTip" Value="Play" />
                                                        <Setter Property="AutomationProperties.Name" Value="Play" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Content" Value="■" />
                                                                <Setter Property="ToolTip" Value="Stop" />
                                                                <Setter Property="AutomationProperties.Name" Value="Stop" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                            <!--
                                                The primary tile has nothing to delete here — it's managed
                                                from the board tile itself (Edit/Delete).
                                            -->
                                            <ui:Button
                                                Margin="6,0,0,0"
                                                Appearance="Danger"
                                                AutomationProperties.Name="Delete"
                                                Command="{Binding DataContext.DeleteVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="✕"
                                                ToolTip="Delete">
                                                <ui:Button.Style>
                                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ui:Button
                    Margin="0,12,0,0"
                    Appearance="Secondary"
                    Command="{Binding RecordVersionCommand}"
                    Content="Add version (record)…" />

                <ui:Button
                    Margin="{StaticResource Space.ButtonRow}"
                    HorizontalAlignment="Right"
                    Appearance="Secondary"
                    Content="Close"
                    IsCancel="True" />
            </StackPanel>
        </Grid>

        <!--
            Same pattern as ManageCategoriesDialog's RootDialogHost: last child = top z-order,
            spans both rows so it dims the title bar too. This window needs its own host — a
            dialog hosted in MainWindow would render behind this modal window.
        -->
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
