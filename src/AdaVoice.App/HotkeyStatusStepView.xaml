<UserControl
    x:Class="AdaVoice.App.HotkeyStatusStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:AdaVoice.App.Resources">
    <StackPanel>
        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.HotkeyStatus_Title}" />
        <TextBlock
            Foreground="{DynamicResource Text.Secondary}"
            Text="{Binding StatusLabel}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
