<UserControl x:Class="AdaVoice.App.HotkeyStatusStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Stop hotkey" Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Text="{Binding StatusLabel}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
    </StackPanel>
</UserControl>
