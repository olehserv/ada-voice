<ui:FluentWindow
    x:Class="AdaVoice.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AdaVoice.App"
    xmlns:res="clr-namespace:AdaVoice.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.Settings_Title}"
    Width="440"
    MaxHeight="680"
    Background="{DynamicResource Surface.Window}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI Variable, Segoe UI"
    FontSize="{StaticResource FontSize.Body}"
    Icon="/Resources/AppIcon.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    TextElement.Foreground="{DynamicResource Text.Primary}"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="{x:Static res:Strings.Settings_Title}"
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="{StaticResource Space.DialogContent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                Grid.Row="0"
                MaxHeight="600"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!--  Appearance  -->
                    <Border Margin="0,0,0,12" Style="{StaticResource PanelStyle}">
                        <StackPanel DataContext="{Binding Appearance}">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_Appearance}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    MinWidth="70"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Text.Secondary}"
                                    Text="{x:Static res:Strings.Settings_Theme}" />
                                <ComboBox
                                    Width="160"
                                    Margin="8,0,0,0"
                                    SelectedValue="{Binding Theme}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{x:Static res:Strings.Settings_ThemeFollowSystem}" Tag="system" />
                                    <ComboBoxItem Content="{x:Static res:Strings.Settings_ThemeLight}" Tag="light" />
                                    <ComboBoxItem Content="{x:Static res:Strings.Settings_ThemeDark}" Tag="dark" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Levels: the group she touches most often — top of the page (design 05 §4)  -->
                    <Border Margin="0,0,0,12" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_Levels}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    MinWidth="70"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Text.Secondary}"
                                    Text="{x:Static res:Strings.Settings_MicDuck}" />
                                <Slider
                                    Width="170"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    LostFocus="DuckSlider_Committed"
                                    Maximum="0"
                                    Minimum="-40"
                                    SmallChange="1"
                                    Thumb.DragCompleted="DuckSlider_DragCompleted"
                                    TickFrequency="1"
                                    Value="{Binding Levels.MicDuckDb, Mode=TwoWay}" />
                                <TextBlock
                                    MinWidth="48"
                                    VerticalAlignment="Center"
                                    Text="{Binding Levels.DuckLabel}"
                                    Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                            <Separator Margin="0,12" Background="{DynamicResource Border.Subtle}" />

                            <!--  Live monitor: hear a phrase in your own headphones while it plays to the call.  -->
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{x:Static res:Strings.Settings_MonitorLivePlayback}"
                                IsChecked="{Binding Levels.MonitorLivePlayback}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    MinWidth="70"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Text.Secondary}"
                                    Text="{x:Static res:Strings.Settings_MonitorVolume}" />
                                <Slider
                                    Width="170"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding Levels.MonitorLivePlayback}"
                                    IsSnapToTickEnabled="True"
                                    LostFocus="MonitorVolumeSlider_Committed"
                                    Maximum="100"
                                    Minimum="0"
                                    SmallChange="1"
                                    Thumb.DragCompleted="MonitorVolumeSlider_DragCompleted"
                                    TickFrequency="5"
                                    Value="{Binding Levels.MonitorVolumePercent, Mode=TwoWay}" />
                                <TextBlock
                                    MinWidth="48"
                                    VerticalAlignment="Center"
                                    Text="{Binding Levels.MonitorVolumeLabel}"
                                    Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="{StaticResource FontSize.Label}"
                                Foreground="{DynamicResource Text.Muted}"
                                Text="{x:Static res:Strings.Settings_MonitorVolumeHint}"
                                TextWrapping="Wrap" />

                            <Separator Margin="0,12" Background="{DynamicResource Border.Subtle}" />
                            <local:CalibrationStepView DataContext="{Binding Levels.Calibration}" />
                        </StackPanel>
                    </Border>

                    <!--  Behavior  -->
                    <Border Margin="0,0,0,12" Style="{StaticResource PanelStyle}">
                        <StackPanel DataContext="{Binding Behavior}">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_Behavior}" />
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{x:Static res:Strings.Settings_AlwaysOnTop}"
                                IsChecked="{Binding AlwaysOnTop}" />
                            <CheckBox Content="{x:Static res:Strings.Settings_ReplaceOnRetrigger}" IsChecked="{Binding ReplaceOnRetrigger}" />
                            <TextBlock
                                Margin="28,0,0,8"
                                FontSize="{StaticResource FontSize.Label}"
                                Foreground="{DynamicResource Text.Muted}"
                                Text="{x:Static res:Strings.Settings_AppliesAfterRestart}" />
                            <TextBlock
                                Foreground="{DynamicResource Text.Secondary}"
                                Text="{Binding HotkeyStatus}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Language & Backup  -->
                    <Border Margin="0,0,0,12" Style="{StaticResource PanelStyle}">
                        <StackPanel DataContext="{Binding Backup}">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{x:Static res:Strings.Settings_LanguageAndBackup}" />

                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <TextBlock
                                    MinWidth="70"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Text.Secondary}"
                                    Text="{x:Static res:Strings.Settings_Language}" />
                                <!--  Each language's own native name — never translated into the current UI language.  -->
                                <ComboBox
                                    Width="160"
                                    Margin="8,0,0,0"
                                    SelectedValue="{Binding Language}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Українська" Tag="uk" />
                                    <ComboBoxItem Content="Polski" Tag="pl" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <ui:Button
                                    Appearance="Secondary"
                                    Command="{Binding ExportCommand}"
                                    Content="{x:Static res:Strings.Settings_Export}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Appearance="Secondary"
                                    Command="{Binding ImportCommand}"
                                    Content="{x:Static res:Strings.Settings_Import}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Appearance="Secondary"
                                    Command="{Binding OpenBackupFolderCommand}"
                                    Content="{x:Static res:Strings.Settings_OpenBackupFolder}" />
                            </StackPanel>

                            <TextBlock FontSize="{StaticResource FontSize.Label}" Foreground="{DynamicResource Text.Muted}">
                                <Run Text="{x:Static res:Strings.Settings_LastBackupLabel}" />
                                <Run Text="{Binding LastBackupDate, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue={x:Static res:Strings.Settings_LastBackupNever}}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <ui:Button
                Grid.Row="1"
                Margin="{StaticResource Space.ButtonRow}"
                HorizontalAlignment="Right"
                Appearance="Success"
                Content="{x:Static res:Strings.Settings_Done}"
                IsCancel="True" />
        </Grid>

        <!--
            Same pattern as MainWindow's RootDialogHost: last child = top z-order, spans both rows
            so it dims the title bar too. This window is its own ContentDialog host because a
            dialog hosted in MainWindow would render behind this modal window (Pass 2b).
        -->
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
