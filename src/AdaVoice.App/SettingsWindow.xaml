<ui:FluentWindow x:Class="AdaVoice.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AdaVoice.App"
        Title="AdaVoice settings"
        Width="440" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{DynamicResource Surface.Window}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="{StaticResource FontSize.Body}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="AdaVoice settings" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <Grid Grid.Row="1" Margin="{StaticResource Space.DialogContent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="600">
        <StackPanel>

        <!-- Levels: the group she touches most often — top of the page (design 05 §4) -->
        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Levels" Style="{StaticResource SectionTitleStyle}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mic duck" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" MinWidth="70" />
                    <Slider Width="170" Margin="8,0" VerticalAlignment="Center"
                            Minimum="-40" Maximum="0" SmallChange="1"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Levels.MicDuckDb, Mode=TwoWay}"
                            Thumb.DragCompleted="DuckSlider_DragCompleted"
                            LostFocus="DuckSlider_Committed" />
                    <TextBlock Text="{Binding Levels.DuckLabel}" Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" MinWidth="48" />
                </StackPanel>
                <Separator Margin="0,12" Background="{DynamicResource Border.Subtle}" />
                <local:CalibrationStepView DataContext="{Binding Levels.Calibration}" />
            </StackPanel>
        </Border>

        <!-- Behavior -->
        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
            <StackPanel DataContext="{Binding Behavior}">
                <TextBlock Text="Behavior" Style="{StaticResource SectionTitleStyle}" />
                <CheckBox Content="Keep the board always on top" IsChecked="{Binding AlwaysOnTop}" Margin="0,0,0,8" />
                <CheckBox Content="A new phrase stops the one currently playing" IsChecked="{Binding ReplaceOnRetrigger}" />
                <TextBlock Text="(applies after restart)" Foreground="{DynamicResource Text.Muted}"
                           FontSize="{StaticResource FontSize.Label}" Margin="28,0,0,8" />
                <TextBlock Text="{Binding HotkeyStatus}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Language & Backup -->
        <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
            <StackPanel DataContext="{Binding Backup}">
                <TextBlock Text="Language &amp; Backup" Style="{StaticResource SectionTitleStyle}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Language" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" MinWidth="70" />
                    <ComboBox Width="160" Margin="8,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding Language}">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Українська" Tag="uk" />
                        <ComboBoxItem Content="Polski" Tag="pl" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Content="Export…" Appearance="Secondary" Command="{Binding ExportCommand}" />
                    <ui:Button Content="Import…" Appearance="Secondary" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
                    <ui:Button Content="Open backup folder" Appearance="Secondary" Command="{Binding OpenBackupFolderCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Foreground="{DynamicResource Text.Muted}" FontSize="{StaticResource FontSize.Label}">
                    <Run Text="Last backup: " />
                    <Run Text="{Binding LastBackupDate, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='never'}" />
                </TextBlock>
            </StackPanel>
        </Border>

        </StackPanel>
        </ScrollViewer>

        <ui:Button Grid.Row="1" Content="Done" Appearance="Secondary" IsCancel="True" HorizontalAlignment="Right" Margin="{StaticResource Space.ButtonRow}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
