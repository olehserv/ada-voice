<ui:FluentWindow
    x:Class="AdaVoice.App.RepairPhraseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:AdaVoice.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.RepairPhrase_Title}"
    Width="380"
    Background="{DynamicResource Surface.Window}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI Variable, Segoe UI"
    FontSize="{StaticResource FontSize.Body}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    TextElement.Foreground="{DynamicResource Text.Primary}"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="{x:Static res:Strings.RepairPhrase_Title}"
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="{StaticResource Space.DialogContent}">
            <TextBlock
                FontSize="{StaticResource FontSize.SectionTitle}"
                FontWeight="SemiBold"
                Text="{Binding Title}"
                TextWrapping="Wrap" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    Foreground="{DynamicResource Status.OffAir}"
                    Text="⚠" />
                <TextBlock
                    Foreground="{DynamicResource Text.Secondary}"
                    Text="{x:Static res:Strings.RepairPhrase_AudioMissing}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource Space.ButtonRow}"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Secondary"
                    Content="{x:Static res:Strings.RepairPhrase_Cancel}"
                    IsCancel="True" />
                <ui:Button
                    Margin="0,0,8,0"
                    Click="Remove_Click"
                    Content="{x:Static res:Strings.RepairPhrase_Remove}"
                    Style="{StaticResource DangerButtonStyle}" />
                <ui:Button
                    Click="ReRecord_Click"
                    Content="{x:Static res:Strings.RepairPhrase_ReRecord}"
                    IsDefault="True"
                    Style="{StaticResource BrandCtaButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
