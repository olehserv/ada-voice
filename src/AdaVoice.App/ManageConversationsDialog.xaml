<ui:FluentWindow
    x:Class="AdaVoice.App.ManageConversationsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:AdaVoice.App.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static res:Strings.ManageConversations_Title}"
    Width="560"
    MaxHeight="620"
    Background="{DynamicResource Surface.Window}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI Variable, Segoe UI"
    FontSize="{StaticResource FontSize.Body}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    TextElement.Foreground="{DynamicResource Text.Primary}"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="{x:Static res:Strings.ManageConversations_Title}"
            Grid.Row="0"
            CanMaximize="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="{StaticResource Space.DialogContent}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Left: the conversation list  -->
            <Grid Grid.Row="0" Grid.Column="0">
                <ListBox
                    MaxHeight="480"
                    DisplayMemberPath="Name"
                    ItemContainerStyle="{StaticResource ConversationListBoxItemStyle}"
                    ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding SelectedRow}" />
                <TextBlock
                    Margin="4,8,4,0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource Text.Muted}"
                    Text="{x:Static res:Strings.ManageConversations_NoConversationsYet}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasNoConversations, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    Grid.Column="0"
                    Height="36"
                    PlaceholderText="{x:Static res:Strings.ManageConversations_NewNamePlaceholder}"
                    Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Grid.Column="1"
                    Height="36"
                    Margin="8,0,0,0"
                    Appearance="Success"
                    AutomationProperties.Name="{x:Static res:Strings.ManageConversations_AddConversation}"
                    Command="{Binding AddCommand}"
                    Content="✓"
                    ToolTip="{x:Static res:Strings.ManageConversations_AddConversation}" />
            </Grid>

            <!--  Right: the selected conversation's steps  -->
            <Border
                Grid.Row="0"
                Grid.Column="2"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding SelectedRow}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Height="36"
                            VerticalAlignment="Center"
                            LostFocus="RowField_Committed"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Grid.Column="1"
                            Height="36"
                            Margin="8,0,0,0"
                            Appearance="Danger"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="{x:Static res:Strings.ManageConversations_Delete}" />
                    </Grid>

                    <CheckBox
                        Margin="0,0,0,8"
                        Content="{x:Static res:Strings.ManageConversations_PlayRandomVersion}"
                        IsChecked="{Binding UseRandomVersion}"
                        IsEnabled="{Binding IsWritable}" />

                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Title}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Appearance="Secondary"
                                            AutomationProperties.Name="{x:Static res:Strings.ManageConversations_MoveUp}"
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="↑"
                                            ToolTip="{x:Static res:Strings.ManageConversations_MoveUp}" />
                                        <ui:Button
                                            Grid.Column="2"
                                            Margin="4,0,0,0"
                                            Appearance="Secondary"
                                            AutomationProperties.Name="{x:Static res:Strings.ManageConversations_MoveDown}"
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="↓"
                                            ToolTip="{x:Static res:Strings.ManageConversations_MoveDown}" />
                                        <ui:Button
                                            Grid.Column="3"
                                            Margin="4,0,0,0"
                                            Appearance="Transparent"
                                            AutomationProperties.Name="{x:Static res:Strings.ManageConversations_Remove}"
                                            Command="{Binding DataContext.RemovePhraseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="✕"
                                            ToolTip="{x:Static res:Strings.ManageConversations_Remove}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Grid.Column="0"
                            Height="36"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Title"
                            ItemsSource="{Binding AddablePhrases}"
                            SelectedItem="{Binding PhraseToAdd}" />
                        <ui:Button
                            Grid.Column="1"
                            Height="36"
                            Margin="8,0,0,0"
                            Command="{Binding AddPhraseCommand}"
                            Content="{x:Static res:Strings.ManageConversations_AddPhrase}" />
                    </Grid>
                </StackPanel>
            </Border>

            <ui:Button
                Grid.Row="1"
                Grid.Column="2"
                Margin="{StaticResource Space.ButtonRow}"
                HorizontalAlignment="Right"
                Appearance="Success"
                Content="{x:Static res:Strings.ManageConversations_Done}"
                IsCancel="True" />
        </Grid>

        <!--
            Same pattern as MainWindow's RootDialogHost: last child = top z-order, spans both
            rows so it dims the title bar too. This window needs its own host — a dialog hosted
            in MainWindow would render behind this modal window.
        -->
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
