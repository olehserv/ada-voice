<ui:FluentWindow x:Class="AdaVoice.App.RecorderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Recorder"
        Width="420" Height="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{DynamicResource Surface.Window}"
        TextElement.Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="{StaticResource FontSize.Body}">
    <!-- Fixed height on purpose: the content swaps between states of different sizes
         (idle / recording / processing / save form), and SizeToContent both mis-measures under
         FluentWindow's custom chrome and would make the window jump on every state change. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Recorder" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" />

        <!-- The recording states (exactly one is visible at a time) -->
        <StackPanel Grid.Row="1" Margin="16,8,16,0">

            <!-- Idle: ready for the next take (also the state after a save/discard) -->
            <ui:Button Content="Record" Appearance="Primary" Icon="{ui:SymbolIcon Mic24}"
                       Command="{Binding StartRecordingCommand}" HorizontalAlignment="Left"
                       Visibility="{Binding ShowRecordButton, Converter={StaticResource BoolToVis}}" />

            <!-- Recording -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Status.Degraded}" VerticalAlignment="Center" />
                <TextBlock Text="Recording… speak now" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                <ui:Button Content="Stop" Appearance="Primary" Command="{Binding StopRecordingCommand}" Margin="16,0,0,0" />
            </StackPanel>

            <!-- Bridges the gap between Stop and the save form appearing -->
            <TextBlock Text="Processing…" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"
                       Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />

            <!-- A take is waiting to be saved -->
            <StackPanel Visibility="{Binding HasPendingTake, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Title" Style="{StaticResource FieldLabelStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1" Text="{Binding PendingTakeDurationLabel}"
                               Typography.NumeralAlignment="Tabular" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Preview" Appearance="Secondary" Command="{Binding PreviewTakeCommand}" />
                    <ui:Button Content="Save" Appearance="Primary" IsDefault="True" Command="{Binding SaveTakeCommand}" Margin="8,0,0,0" />
                    <ui:Button Content="Discard" Appearance="Secondary" Command="{Binding DiscardTakeCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Recording errors / hints ("No signal", "Take discarded.", …) arrive as toasts
                 in the main window's bottom-right corner, like every other notification. -->
        </StackPanel>

        <!-- Footer pinned to the bottom -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="While recording, the call cannot hear you (OFF AIR)."
                       Foreground="{DynamicResource Text.Muted}" FontSize="{StaticResource FontSize.Label}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ui:Button Grid.Column="1" Content="Close" Appearance="Secondary" IsCancel="True"
                       VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</ui:FluentWindow>
