<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The LibraryImport source generator emits unsafe marshalling code for the string parameter. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Phase 1 composition root: wires the engine to real WASAPI and runs it live.
         EngineHost is reusable product code the future WPF app will host; Program is a
         throwaway console driver for now. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdaVoice.Audio\AdaVoice.Audio.csproj" />
    <ProjectReference Include="..\AdaVoice.Audio.Wasapi\AdaVoice.Audio.Wasapi.csproj" />
    <ProjectReference Include="..\AdaVoice.Core\AdaVoice.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
